# Your Convex deployment URL. `npx convex dev` writes this into .env.local.
# NEXT_PUBLIC_ exposes it to the browser — there is no VITE_* in Next.js.
NEXT_PUBLIC_CONVEX_URL=

# The origin this app is served from. The cookie handler accepts requests only
# from exact origins in this list — never a wildcard.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Nothing about Logto belongs here. Session mode keeps the endpoint, the app id
# and the client secret on the Convex deployment, so the bundle carries none of
# them. Set them there instead — the secret must never reach the browser:
#   npx convex env set LOGTO_ENDPOINT      https://auth.example.com
#   npx convex env set LOGTO_APP_ID        your-traditional-web-app-id
#   npx convex env set LOGTO_CLIENT_SECRET your-traditional-web-app-secret
