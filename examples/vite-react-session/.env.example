# Your Convex deployment URL, printed by `npx convex dev`.
VITE_CONVEX_URL=
# That's all. In session mode the Logto config (endpoint, app id, app secret)
# lives on the Convex deployment, not in the frontend bundle:
#   npx convex env set LOGTO_ENDPOINT      https://your-logto.example.com
#   npx convex env set LOGTO_APP_ID        your-traditional-web-app-id
#   npx convex env set LOGTO_CLIENT_SECRET your-traditional-web-app-secret
