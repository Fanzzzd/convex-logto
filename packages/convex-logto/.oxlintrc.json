{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": [
      "warn",
      { "allow": ["_id", "_creationTime", "_args", "_returnType"] }
    ]
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist"]
}
