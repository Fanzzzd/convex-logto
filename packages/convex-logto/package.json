{
  "name": "convex-logto",
  "version": "0.7.1",
  "description": "Use Logto (self-hosted or cloud) as the auth provider for Convex React apps: an ID-token OIDC bridge plus a signed webhook user-sync, modeled on convex/react-clerk and @convex-dev/workos-authkit.",
  "type": "module",
  "license": "MIT",
  "author": "Fanzzzd (https://github.com/Fanzzzd)",
  "keywords": [
    "convex",
    "logto",
    "auth",
    "authentication",
    "oidc",
    "react",
    "webhook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fanzzzd/convex-logto.git",
    "directory": "packages/convex-logto"
  },
  "homepage": "https://github.com/Fanzzzd/convex-logto#readme",
  "bugs": "https://github.com/Fanzzzd/convex-logto/issues",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/component",
    "!src/component/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./native-session": {
      "types": "./dist/native-session.d.ts",
      "import": "./dist/native-session.js"
    },
    "./react-session": {
      "types": "./dist/react-session.d.ts",
      "import": "./dist/react-session.js"
    },
    "./convex.config": {
      "@convex-dev/component-source": "./src/component/convex.config.ts",
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "@convex-dev/component-source": "./src/component/convex.config.ts",
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup && tsc -p tsconfig.component.json && node scripts/verify-build-artifacts.mjs",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "lint:package": "pnpm run build && publint --strict && attw --pack --profile node16 --ignore-rules cjs-resolves-to-esm",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@logto/react": ">=4.0.0",
    "@logto/rn": ">=1.1.0",
    "convex": ">=1.21.0",
    "expo-secure-store": ">=14.0.0",
    "expo-web-browser": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@logto/react": {
      "optional": true
    },
    "@logto/rn": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@logto/react": "^4.0.14",
    "@logto/rn": "^1.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "convex": "^1.44.0",
    "expo-secure-store": "^56.0.4",
    "expo-web-browser": "^56.0.5",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
