{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    // No ambient @types packages. The library must not see Node globals: it
    // runs in Convex's V8 runtime and in browsers, where `Buffer` and `node:*`
    // do not exist. Node-side code (tests, src/cli) is checked by
    // tsconfig.node.json instead.
    "types": [],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/cli", "dist", "node_modules"]
}
