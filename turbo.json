{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_CONVEX_URL"],
      "outputs": ["dist/**", ".next/**", ".output/**"]
    },
    "check-types": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "lint": {},
    "format": { "cache": false },
    "format:check": {},
    "lint:package": {}
  }
}
